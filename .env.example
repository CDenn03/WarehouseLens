# Copy to .env for local dev (docker compose). Deployed values live in Railway's
# variable store — see RAILWAY.md.
DATABASE_URL=postgresql+psycopg://wms:wms_dev_password@postgres:5432/wms
REDIS_URL=redis://redis:6379/0
KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/warehouselens
KEYCLOAK_CLIENT_ID=warehouselens-backend
KEYCLOAK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/docs

# Keycloak Admin API — required to create tenant admins and platform admins.
# URL and realm are derived from KEYCLOAK_ISSUER_URL when left blank.
# In production prefer a service-account client:
#   KEYCLOAK_ADMIN_AUTH_REALM=warehouselens
#   KEYCLOAK_ADMIN_CLIENT_ID=warehouselens-provisioner
#   KEYCLOAK_ADMIN_CLIENT_SECRET=<secret>
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_REALM=warehouselens
KEYCLOAK_ADMIN_AUTH_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Temporary password issued to every provisioned admin (changed at first login).
INITIAL_ADMIN_PASSWORD=Changeme1
# Google AI Studio API key for the copilot's Gemini calls.
LLM_API_KEY=replace-me
LLM_MODEL=gemini-flash-lite-latest

# Frontend
API_URL=http://backend:8000
NEXT_PUBLIC_APP_NAME=WarehouseLens
