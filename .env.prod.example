# Copy to .env.prod on the VM (never commit the real file — it's gitignored
# the same way .env is). Fill in every placeholder before
# `docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build`.
# See ORACLE_CLOUD.md for what each section means and where the values come from.

# ── Security-critical: do not skip ──────────────────────────────────────
# X-Debug-User (local-dev identity bypass, app/core/security.py) is only
# disabled when this is exactly "production". Get this wrong and anyone can
# authenticate as any user by sending a header.
ENVIRONMENT=production

# ── Domains (bare hostnames, no scheme — Caddy needs them this way) ─────
# Both must have an A record pointing at this VM's public IP before Caddy can
# issue certificates (step 4).
FRONTEND_DOMAIN=app.replace-me.com
KEYCLOAK_DOMAIN=auth.replace-me.com

# ── Neon: app database (the "wms" database from RAILWAY.md step 1) ──────
# Pooled (PgBouncer) connection string, NOT the direct one — this VM's
# containers restart independently, same reasoning as the Railway plan.
# Neon gives you postgresql://...; add +psycopg after postgresql and confirm
# ?sslmode=require is present.
DATABASE_URL=postgresql+psycopg://replace-me?sslmode=require

# ── Neon: Keycloak's own database (the second, separate database) ───────
KEYCLOAK_DB_URL=jdbc:postgresql://replace-me/keycloak?sslmode=require
KEYCLOAK_DB_USERNAME=replace-me
KEYCLOAK_DB_PASSWORD=replace-me

# ── Redis (internal — the redis container on this same VM) ──────────────
REDIS_URL=redis://redis:6379/0

# ── Keycloak bootstrap admin ─────────────────────────────────────────────
# Real values — RAILWAY.md's warning applies here too: no longer admin/admin.
# Also doubles as the backend's admin-API credentials (app/core/config.py's
# keycloak_admin_username/password) — same account, two consumers.
KEYCLOAK_ADMIN_USERNAME=replace-me
KEYCLOAK_ADMIN_PASSWORD=replace-me

# ── Backend: public Keycloak URL (must match the JWT `iss` claim) ───────
KEYCLOAK_ISSUER_URL=https://auth.replace-me.com/realms/warehouselens

# ── Backend: initial password for newly-provisioned tenant/platform admins ─
INITIAL_ADMIN_PASSWORD=replace-me

# ── Backend: bootstrap emails (see config.py's own comment on these) ────
DEFAULT_TENANT_SUPERUSER_EMAIL=admin@replace-me.com
PLATFORM_ADMIN_EMAIL=platform@replace-me.com

# ── Backend: copilot LLM (Google AI Studio) ──────────────────────────────
LLM_API_KEY=replace-me
LLM_MODEL=gemini-flash-lite-latest

# ── Frontend: NextAuth ───────────────────────────────────────────────────
NEXTAUTH_URL=https://app.replace-me.com
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me
NEXT_PUBLIC_APP_NAME=WarehouseLens

# ── Frontend: Keycloak OIDC client (its own client, distinct from the
# backend's warehouselens-backend client — see ORACLE_CLOUD.md step 3) ────
KEYCLOAK_ISSUER=https://auth.replace-me.com/realms/warehouselens
KEYCLOAK_CLIENT_ID=warehouselens-frontend
KEYCLOAK_CLIENT_SECRET=replace-me
