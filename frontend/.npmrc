# Reject any install command that isn't pnpm
engine-strict=true

# pnpm v9 — builds must be explicitly approved via pnpm-workspace.yaml
# (see onlyBuiltDependencies list there, or run `pnpm approve-builds`)
enable-pre-post-scripts=true

# Skip interactive node_modules purge prompt (fails in Docker/CI)
confirmModulesPurge=false

# Network resilience — registry.npmjs.org can be slow; give it room
fetch-timeout=300000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-retries=5
